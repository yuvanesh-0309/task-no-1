<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Creative digital solutions that help your business grow.">
  <title>Simple Site — Digital solutions that grow with you</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');

    :root {
      --ink: #11110f;
      --paper: #f5f4ee;
      --white: #fffefa;
      --purple: #9875ff;
      --yellow: #e9fa31;
      --muted: #62615b;
      --line: rgba(17, 17, 15, .2);
      --display: 'Space Grotesk', Arial, sans-serif;
      --mono: 'DM Mono', monospace;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--display);
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; }
    .wrap { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }

    .topline {
      border-bottom: 1px solid var(--line);
      font: 11px var(--mono);
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .topline .wrap {
      display: flex;
      justify-content: space-between;
      padding: 11px 0;
    }
    .status { display: flex; align-items: center; gap: 8px; }
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #91bd2e;
      box-shadow: 0 0 0 3px #91bd2e25;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 5;
      background: rgba(245, 244, 238, .92);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }
    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      letter-spacing: -.04em;
    }
    .brandmark {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      background: var(--yellow);
      border: 1.5px solid var(--ink);
      box-shadow: 3px 3px 0 var(--ink);
      font-size: 19px;
    }
    .links {
      display: flex;
      align-items: center;
      gap: 32px;
      font-size: 13px;
      font-weight: 600;
    }
    .links a:not(.nav-cta) { transition: opacity .2s; }
    .links a:not(.nav-cta):hover { opacity: .55; }
    .nav-cta, .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 12px 16px;
      border: 1.5px solid var(--ink);
      background: var(--purple);
      box-shadow: 3px 3px 0 var(--ink);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
      transition: transform .18s, box-shadow .18s;
    }
    .nav-cta:hover, .button:hover {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 var(--ink);
    }
    .menu {
      display: none;
      border: 1px solid var(--ink);
      background: none;
      padding: 9px;
      font-size: 12px;
    }

    .hero {
      padding: 72px 0 66px;
      border-bottom: 1px solid var(--line);
      overflow: hidden;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 56px;
      align-items: center;
    }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      background: var(--purple);
      border: 1.5px solid var(--ink);
      box-shadow: 3px 3px 0 var(--ink);
      padding: 7px 10px;
      font: 11px var(--mono);
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .hero h1 {
      font-size: clamp(48px, 7vw, 88px);
      line-height: .94;
      letter-spacing: -.075em;
      margin: 24px 0 20px;
      max-width: 660px;
    }
    .hero h1 span {
      background: var(--yellow);
      box-shadow: 5px 0 var(--yellow), -2px 0 var(--yellow);
      padding: 0 .05em;
    }
    .intro {
      max-width: 470px;
      font-size: 17px;
      line-height: 1.6;
      color: #4c4b46;
      margin: 0 0 28px;
    }
    .actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
    .text-link {
      display: inline-flex;
      gap: 8px;
      align-items: center;
      font-size: 13px;
      font-weight: 700;
    }
    .text-link span { font-size: 18px; transition: transform .2s; }
    .text-link:hover span { transform: translateX(4px); }

    .art {
      position: relative;
      min-height: 400px;
      display: grid;
      place-items: center;
    }
    .art-frame {
      position: relative;
      width: min(100%, 450px);
      height: 350px;
      background: var(--purple);
      border: 1.5px solid var(--ink);
      box-shadow: 8px 8px 0 var(--ink);
      overflow: hidden;
    }
    .sun {
      position: absolute;
      width: 178px;
      height: 178px;
      border-radius: 50%;
      background: var(--yellow);
      right: 45px;
      top: 53px;
    }
    .orb {
      position: absolute;
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: var(--ink);
      right: 82px;
      top: 94px;
    }
    .orb:after {
      content: '';
      position: absolute;
      background: var(--yellow);
      width: 66px;
      height: 66px;
      border-radius: 50%;
      top: 58px;
      left: 58px;
    }
    .stairs { position: absolute; bottom: 0; left: 0; display: flex; align-items: flex-end; }
    .stairs i {
      display: block;
      background: var(--white);
      border: 1.5px solid var(--ink);
      border-bottom: 0;
      width: 43px;
    }
    .stairs i:nth-child(1) { height: 42px; }
    .stairs i:nth-child(2) { height: 84px; }
    .stairs i:nth-child(3) { height: 126px; }
    .stairs i:nth-child(4) { height: 168px; }
    .art-label {
      position: absolute;
      bottom: 22px;
      right: 20px;
      background: var(--white);
      border: 1px solid var(--ink);
      padding: 9px 11px;
      font: 10px var(--mono);
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .spark { position: absolute; font-size: 35px; }
    .spark.one { top: 22px; left: 30px; }
    .spark.two { bottom: 35px; right: 22px; color: var(--yellow); }
    .art-note {
      position: absolute;
      top: 8px;
      right: -5px;
      background: var(--yellow);
      border: 1.5px solid var(--ink);
      box-shadow: 4px 4px 0 var(--ink);
      padding: 11px 14px;
      font: 10px var(--mono);
      line-height: 1.5;
      transform: rotate(3deg);
    }

    .section { padding: 64px 0; }
    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 28px;
      margin-bottom: 27px;
    }
    .kicker {
      font: 11px var(--mono);
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    h2 {
      font-size: clamp(30px, 4vw, 48px);
      letter-spacing: -.065em;
      line-height: 1;
      margin: 10px 0 0;
    }
    .section-head p {
      color: var(--muted);
      max-width: 330px;
      line-height: 1.6;
      font-size: 14px;
      margin: 0;
    }
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .card {
      background: var(--white);
      border: 1px solid var(--ink);
      padding: 22px;
      min-height: 218px;
      display: flex;
      flex-direction: column;
      transition: transform .2s, box-shadow .2s;
    }
    .card:hover { transform: translateY(-4px); box-shadow: 4px 5px 0 var(--ink); }
    .card-top { display: flex; justify-content: space-between; align-items: center; }
    .icon {
      width: 45px;
      height: 45px;
      display: grid;
      place-items: center;
      border: 1px solid var(--ink);
      background: var(--yellow);
      font-size: 22px;
    }
    .card:nth-child(2) .icon { background: var(--purple); }
    .card:nth-child(3) .icon { background: #c6dcff; }
    .number { font: 11px var(--mono); color: var(--muted); }
    .card h3 { font-size: 20px; letter-spacing: -.04em; margin: 24px 0 7px; }
    .card p { color: var(--muted); font-size: 13px; line-height: 1.55; margin: 0; max-width: 270px; }
    .card-link {
      margin-top: auto;
      padding-top: 15px;
      font: 11px var(--mono);
      text-transform: uppercase;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .card-link b { font: 20px var(--display); }

    .band { padding: 0 0 70px; }
    .band-inner {
      background: var(--yellow);
      border: 1.5px solid var(--ink);
      box-shadow: 6px 6px 0 var(--ink);
      padding: 30px 34px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }
    .band h2 { font-size: clamp(26px, 4vw, 42px); max-width: 590px; margin: 0; }
    .band p { font-size: 13px; line-height: 1.5; max-width: 360px; margin: 10px 0 0; }
    .band .button { flex-shrink: 0; background: var(--white); }
    footer { border-top: 1px solid var(--line); padding: 22px 0; color: var(--muted); font: 11px var(--mono); }
    footer .wrap { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }

    @media (max-width: 760px) {
      .wrap { width: min(100% - 32px, 560px); }
      .topline .wrap { font-size: 9px; }
      .nav { min-height: 64px; }
      .links {
        display: none;
        position: absolute;
        top: 64px;
        left: 0;
        right: 0;
        padding: 20px 24px 24px;
        background: var(--paper);
        border-bottom: 1px solid var(--line);
        align-items: stretch;
        gap: 17px;
      }
      .links.open { display: flex; flex-direction: column; }
      .links a { padding: 4px 0; }
      .links .nav-cta { align-self: flex-start; }
      .menu { display: block; }
      .hero { padding: 46px 0 48px; }
      .hero-grid { grid-template-columns: 1fr; gap: 28px; }
      .hero h1 { font-size: clamp(52px, 13vw, 76px); }
      .intro { font-size: 15px; }
      .art { min-height: 310px; }
      .art-frame { height: 280px; width: calc(100% - 18px); }
      .sun { width: 145px; height: 145px; right: 35px; top: 38px; }
      .orb { width: 148px; height: 148px; right: 68px; top: 71px; }
      .orb:after { width: 54px; height: 54px; top: 47px; left: 47px; }
      .stairs i { width: 37px; }
      .stairs i:nth-child(1) { height: 34px; }
      .stairs i:nth-child(2) { height: 68px; }
      .stairs i:nth-child(3) { height: 102px; }
      .stairs i:nth-child(4) { height: 136px; }
      .section { padding: 48px 0; }
      .section-head { align-items: flex-start; flex-direction: column; gap: 13px; }
      .cards { grid-template-columns: 1fr; }
      .card { min-height: 190px; }
      .band { padding-bottom: 52px; }
      .band-inner { align-items: flex-start; flex-direction: column; padding: 25px; }
      .band .button { margin-top: 3px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition: none !important; }
    }
  </style>
</head>
<body>
  <div class="topline">
    <div class="wrap">
      <span>Independent creative studio · Est. 2024</span>
      <span class="status"><i class="dot"></i> Available for projects</span>
    </div>
  </div>

  <header>
    <nav class="nav wrap" aria-label="Main navigation">
      <a class="brand" href="#home" aria-label="Simple Site home">
        <span class="brandmark">✳</span> simple site
      </a>
      <button class="menu" aria-expanded="false" aria-controls="nav-links">MENU</button>
      <div class="links" id="nav-links">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
        <a class="nav-cta" href="#contact">Let’s talk <span>↗</span></a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="wrap hero-grid">
        <div>
          <div class="eyebrow">✳ &nbsp; Small studio, big ideas</div>
          <h1>We create digital solutions that <span>grow.</span></h1>
          <p class="intro">
            A thoughtful creative team helping ambitious businesses look sharp,
            work smarter, and connect with the people who matter.
          </p>
          <div class="actions">
            <a class="button" href="#services">Explore services <span>→</span></a>
            <a class="text-link" href="#about">Get to know us <span>↘</span></a>
          </div>
        </div>

        <div class="art" aria-label="Abstract illustration of growth">
          <div class="art-note">Good ideas<br>go places ↗</div>
          <div class="art-frame">
            <span class="spark one">✳</span>
            <div class="sun"></div>
            <div class="orb"></div>
            <div class="stairs"><i></i><i></i><i></i><i></i></div>
            <span class="art-label">Make room to grow</span>
            <span class="spark two">✳</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="services">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="kicker">What we’re good at</div>
            <h2>Good work. Clear results.</h2>
          </div>
          <p>
            From the first idea to the final detail, we bring the right pieces
            together to move your business forward.
          </p>
        </div>

        <div class="cards">
          <a class="card" href="#contact">
            <div class="card-top"><span class="icon">▦</span><span class="number">01 / 03</span></div>
            <h3>Brand & strategy</h3>
            <p>Find your voice, sharpen your story, and build a brand people remember.</p>
            <span class="card-link">Explore branding <b>↗</b></span>
          </a>
          <a class="card" href="#contact">
            <div class="card-top"><span class="icon">◇</span><span class="number">02 / 03</span></div>
            <h3>Web design</h3>
            <p>Friendly, useful websites designed to turn a good first impression into action.</p>
            <span class="card-link">Explore web design <b>↗</b></span>
          </a>
          <a class="card" href="#contact">
            <div class="card-top"><span class="icon">✉</span><span class="number">03 / 03</span></div>
            <h3>Digital growth</h3>
            <p>Make the most of every channel with smart content and ongoing support.</p>
            <span class="card-link">Explore growth <b>↗</b></span>
          </a>
        </div>
      </div>
    </section>

    <section class="band" id="about">
      <div class="wrap">
        <div class="band-inner">
          <div>
            <h2>Let’s make your next good thing happen.</h2>
            <p>We’re a close-knit team with a practical approach and a soft spot for bold ideas.</p>
          </div>
          <a class="button" href="mailto:hello@simplesite.studio" id="contact">
            Start a conversation <span>↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span><strong>simple site</strong> · Digital made thoughtful.</span>
      <span>© <span id="year"></span> Simple Site Studio</span>
      <a href="mailto:hello@simplesite.studio">hello@simplesite.studio ↗</a>
    </div>
  </footer>

  <script>
    const menu = document.querySelector('.menu');
    const links = document.querySelector('.links');

    menu.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      menu.setAttribute('aria-expanded', open);
    });

    links.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        links.classList.remove('open');
        menu.setAttribute('aria-expanded', 'false');
      });
    });

    document.querySelector('#year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
